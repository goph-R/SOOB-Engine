# Build output
*.o
*.exe
sdlfun
soob_editor
build/
raw/obj/

# FLTK static libs built by build_fltk.bat. The FLTK source and the four
# engine-provided support files (config.h, FL/abi-version.h, fltk_core.list,
# fltk_gl.list) stay tracked; only the built .a output is ignored.
# (FLTK object files land in raw/obj/fltk/, already covered by raw/obj/.)
vendor/fltk-1.3/FL/lib/
# Win10 (WinLibs) FLTK libs from build_fltk_win10.bat.
vendor/fltk-1.3/FL/lib_w10/

# Engine Lua modules copied from ../SOOB-Core/ at build time.
# Source of truth lives in SOOB-Core; this dir is regenerated on each build.
scripts/engine/

# Temp/log files
output.txt
stdout.txt
stderr.txt
build_fltk_output.txt
codeedit.log

# Runtime + editor output written next to the exe. Anchored to the repo root
# so they never shadow the tracked level data under assets/levels/.
/sdlfun.dat
/level.obj
/level.mtl
/level.lvl

# Downloaded installers
ms3d184setup.exe

# Win10 build - portable MinGW (download separately, ~250MB)
vendor_win10/mingw32/
vendor_win10/SDL.dll
libwinpthread-1.dll
